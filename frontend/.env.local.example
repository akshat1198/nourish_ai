# Backend API (browser talks to FastAPI directly; CORS-enabled)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Dev identity used only while signed out (backend AUTH_MODE=disabled).
NEXT_PUBLIC_DEV_USER_KEY=dev-user

# Show Google sign-in UI + enforce /app auth. Keep false until the Google
# client below is filled in.
NEXT_PUBLIC_AUTH_ENABLED=false

# --- Auth.js / Google OAuth (Stage 5.5) ---
AUTH_SECRET=            # openssl rand -base64 32  (cookie/JWE encryption)
AUTH_SHARED_SECRET=     # openssl rand -base64 32  — MUST match backend AUTH_SHARED_SECRET
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=         # Google Cloud Console → OAuth client (Web)
AUTH_GOOGLE_SECRET=
