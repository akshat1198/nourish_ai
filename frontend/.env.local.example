# Backend API (browser talks to FastAPI directly; CORS-enabled)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Dev identity while the backend runs AUTH_MODE=disabled (Stage 5.2-5.4).
# Sent as X-User-Key so pantry/profile persist per person before Google auth (5.5).
NEXT_PUBLIC_DEV_USER_KEY=dev-akshat

# --- Auth.js / Google OAuth (wired in Stage 5.5) ---
# AUTH_SECRET=            # openssl rand -base64 32  (cookie/JWE encryption)
# AUTH_SHARED_SECRET=     # openssl rand -base64 32  (HS256 API token — DIFFERENT value)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_URL=http://localhost:3000
