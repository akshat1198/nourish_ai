# Copy to .env and adjust. .env is gitignored — never commit real values.

# PostgreSQL (used by docker-compose for the db + backend services)
POSTGRES_USER=pantry
POSTGRES_PASSWORD=pantrypw
POSTGRES_DB=pantrydb

# Host-run API (docker compose derives these itself for the backend container)
DATABASE_URL=postgresql+psycopg2://pantry:pantrypw@localhost:5432/pantrydb
REDIS_URL=redis://localhost:6379/0

# Stage 2+ (LLM features)
# ANTHROPIC_API_KEY=sk-ant-...

# Auth (Stage 5.5): AUTH_MODE=disabled (default) keeps the API open via
# X-User-Key; AUTH_MODE=jwt verifies the HS256 bearer minted by the frontend.
AUTH_MODE=disabled
AUTH_SHARED_SECRET=   # openssl rand -base64 32 — must match frontend AUTH_SHARED_SECRET
