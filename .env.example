# Copy to .env and adjust. .env is gitignored — never commit real values.

# PostgreSQL (used by docker-compose for the db + backend services)
POSTGRES_USER=pantry
POSTGRES_PASSWORD=pantrypw
POSTGRES_DB=pantrydb

# Host-run API (docker compose derives these itself for the backend container)
DATABASE_URL=postgresql+psycopg2://pantry:pantrypw@localhost:5432/pantrydb
REDIS_URL=redis://localhost:6379/0

# Stage 2+ (LLM features)
# ANTHROPIC_API_KEY=sk-ant-...

# Auth (Stage 5.5). docker-compose reads AUTH_MODE from here (${AUTH_MODE:-disabled}),
# so flipping is a one-line change — no compose edit needed.
#   disabled (default): API is open; identity via the X-User-Key header. Keeps
#                       dev + the test suite working with no tokens.
#   jwt:                FastAPI verifies the HS256 bearer minted by the Next.js
#                       Auth.js layer and ignores X-User-Key.
#
# To turn on real auth (do these together, or /app calls will 401):
#   1. Create the Google OAuth Web client and set AUTH_GOOGLE_ID/SECRET +
#      NEXT_PUBLIC_AUTH_ENABLED=true in frontend/.env.local (see that file).
#   2. Set a shared secret below that MATCHES frontend AUTH_SHARED_SECRET.
#   3. Flip AUTH_MODE=jwt here, then rebuild/restart the backend.
AUTH_MODE=disabled
AUTH_SHARED_SECRET=   # openssl rand -base64 32 — must match frontend AUTH_SHARED_SECRET
